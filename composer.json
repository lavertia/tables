{
  "name": "lavertia/tables",
  "description": "Composable scoped Eloquent tables, columns, filters and pagination for Lavertia",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "laravel/framework": "^12.0 || ^13.0",
    "lavertia/support": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Lavertia\\Tables\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lavertia\\Tables\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "laravel/pint": "^1.27"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "lint": "@php vendor/bin/pint --test"
  }
}
